{
  "name": "ark-platform",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "ark-platform-staging",
      "vars": {
        "ENVIRONMENT": "staging"
      }
    },
    "production": {
      "name": "ark-platform",
      "vars": {
        "ENVIRONMENT": "production"
      }
    }
  }
}
