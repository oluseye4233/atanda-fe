{
  "name": "atanda-fe",
  "main": "worker/arkx-gateway.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "ark-platform-staging",
      "vars": {
        "ENVIRONMENT": "staging"
      }
    },
    "production": {
      "name": "ark-platform",
      "vars": {
        "ENVIRONMENT": "production"
      }
    }
  }
}
